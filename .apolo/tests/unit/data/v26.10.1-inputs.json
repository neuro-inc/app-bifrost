        "base_path": "/",
        "api_type": "rest",
        "api_base_path": "/v1",
        "openai_api_type": "chat",
        "endpoint_url": "/v1/chat",
        "hf_model": {
          "model_hf_name": "meta-llama/Llama-3.1-8B-Instruct",
          "hf_token": null,
          "hf_cache": null,
          "__type__": "HuggingFaceModel"
        },
        "__type__": "OpenAICompatChatAPI"
      },
      "api_key": {
        "key": "llama-api-key",
        "__type__": "ApoloSecret"
      },
      "served_model_name": null,
      "__type__": "VLLMBackend"
    },
    {
      "api": {
        "host": "llama-second.namespace",
        "port": 8000,
        "protocol": "http",
        "timeout": 30.0,
        "base_path": "/",
        "api_type": "rest",
        "api_base_path": "/v1",
        "openai_api_type": "chat",
        "endpoint_url": "/v1/chat",
        "hf_model": {
          "model_hf_name": "meta-llama/Llama-3.1-8B-Instruct",
          "hf_token": null,
          "hf_cache": null,
