        },
        "__type__": "OpenAICompatChatAPI"
      },
      "api_key": null,
      "served_model_name": null,
      "__type__": "VLLMBackend"
    },
    {
      "api": {
        "host": "qwen.namespace",
        "port": 8000,
        "protocol": "http",
        "timeout": 30.0,
        "base_path": "/",
        "api_type": "rest",
        "api_base_path": "/v1",
        "openai_api_type": "chat",
        "endpoint_url": "/v1/chat",
        "hf_model": null,
        "__type__": "OpenAICompatChatAPI"
      },
      "api_key": null,
      "served_model_name": "qwen",
      "__type__": "VLLMBackend"
