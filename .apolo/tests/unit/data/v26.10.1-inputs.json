{
  "preset": {
    "name": "gateway-large",
    "__type__": "Preset"
  },
  "networking": {
    "ingress_http": {
      "auth": {
        "type": "apolo_auth",
        "__type__": "ApoloAuth"
      },
      "__type__": "IngressHttp"
    },
    "__type__": "BasicNetworkingConfig"
  },
  "storage": {
    "storage_type": "postgres",
    "credentials": {
      "user": "bifrost",
      "password": {
        "key": "pg-bifrost-password",
        "__type__": "ApoloSecret"
      },
      "host": "pg-app-primary.namespace.svc",
      "port": 5432,
      "pgbouncer_host": "pg-app-pgbouncer.namespace.svc",
      "pgbouncer_port": 5432,
      "dbname": "bifrost",
      "pgbouncer_uri": null,
      "postgres_uri": null,
      "user_type": "user",
      "__type__": "CrunchyPostgresUserCredentials"
    },
    "__type__": "PostgresStorage"
  },
  "security": {
    "admin_username": "admin",
    "admin_password": {
      "key": "bifrost-admin-password",
      "__type__": "ApoloSecret"
    },
    "encryption_key": {
      "key": "bifrost-encryption-key",
      "__type__": "ApoloSecret"
    },
    "require_virtual_key": true,
    "__type__": "BifrostSecurity"
  },
  "vllm_backends": [
